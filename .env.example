# Copy to .env and adjust. .env is git-ignored; never commit real secrets.
# Required when DEBUG=False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Asia/Tokyo
LOG_LEVEL=INFO
# Defaults to the local SQLite file when unset.
# DATABASE_URL=sqlite:///db.sqlite3
# Site identity
BLOG_TITLE=Suresh's Blog
BLOG_DESCRIPTION=A software engineer in Japan, writing about the places I visit.
BLOG_POSTS_PER_PAGE=6
BLOG_LATEST_POSTS_COUNT=6
# Uploaded pictures are resized and re-compressed on save. Lower these to
# shrink files further; raise max dimension if you need bigger originals.
IMAGE_MAX_DIMENSION=1600
IMAGE_JPEG_QUALITY=80
# Where uploads are stored. Override it (together with DATABASE_URL) when you
# want a throwaway instance that cannot touch the real uploads directory.
# MEDIA_ROOT=/tmp/blog-scratch-uploads
# Social profiles. Set a bare handle (with or without a leading @) and the URL
# is built for you; or paste a full https:// URL. Leave one blank and it simply
# does not appear on the site. Only link accounts you actually post to.
SOCIAL_INSTAGRAM=
SOCIAL_FACEBOOK=
SOCIAL_TIKTOK=
SOCIAL_LINKEDIN=
SOCIAL_X=
SOCIAL_YOUTUBE=
SOCIAL_GITHUB=
# These two need a full URL, since instances and domains vary:
SOCIAL_MASTODON=
SOCIAL_WEBSITE=
# Only used when DEBUG=False, e.g. https://blog.example.com
# CSRF_TRUSTED_ORIGINS=
# Uploads: leave blank to store them on disk in uploads/.
# Set to the URL from your Cloudinary dashboard to use their CDN instead.
CLOUDINARY_URL=
