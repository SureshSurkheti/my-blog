{% load static %}{% comment %}
Served through a view rather than shipped as a static file. The manifest names
other static files, and outside DEBUG those carry a content hash in their
filename — Django rewrites such references inside CSS, but not inside a
manifest, so hard-coded paths here would 404 in production. {% static %}
resolves them the same way the templates do.
{% endcomment %}{
  {% comment %}escapejs, not the default HTML escaping: this is JSON, and
  an apostrophe turned into &#x27; would be the literal app name on someone's
  home screen. escapejs emits \u0027, which is valid JSON.{% endcomment %}
  "name": "{{ blog.title|escapejs }}",
  "short_name": "{{ blog.title|escapejs }}",
  "icons": [
    { "src": "{% static 'icon-192.png' %}", "sizes": "192x192", "type": "image/png" },
    { "src": "{% static 'icon-512.png' %}", "sizes": "512x512", "type": "image/png" }
  ],
  "theme_color": "#003893",
  "background_color": "#003893",
  "display": "standalone",
  "start_url": "/"
}
